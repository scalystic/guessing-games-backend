# Copy to .env and fill in for local dev. In Render, these come from
# render.yaml (the three marked `sync: false` are prompted for when the
# blueprint is applied) — this file is just documentation + local dev.

# Same Neon/Postgres database the main app uses. Copy the exact value from
# the main app's .env — this server reads and writes the same tables.
DATABASE_URL=""

# Public URL of the main Next.js app (Vercel), no trailing slash. Required —
# this server calls back into it (POST /api/runs/:id/giveup) when a
# multiplayer round has to be force-completed. e.g. https://sargam.vercel.app
APP_BASE_URL=""

# Comma-separated list of origins allowed to open a socket connection here —
# your Vercel domain, plus http://localhost:3000 if you run the main app
# locally against this server. Leave unset to allow any origin.
CORS_ORIGIN=""

# Render sets PORT automatically in production; only needed for local dev if
# you want something other than the 4000 default.
PORT="4000"
