# Copy to .env and fill in for local dev. In Render, these come from
# render.yaml (the three marked `sync: false` are prompted for when the
# blueprint is applied) — this file is just documentation + local dev.

# Same Neon/Postgres database the main app uses. Copy the exact value from
# the main app's .env — this server reads and writes the same tables.
DATABASE_URL=""

# Public URL of the main Next.js app (Vercel), no trailing slash. Required —
# this server calls back into it (POST /api/runs/:id/giveup) when a
# multiplayer round has to be force-completed. e.g. https://sargam.vercel.app
APP_BASE_URL=""

# Comma-separated list of origins allowed to open a socket connection here —
# your Vercel domain, plus http://localhost:3000 if you run the main app
# locally against this server. Leave unset to allow any origin.
CORS_ORIGIN=""

# Render sets PORT automatically in production; only needed for local dev if
# you want something other than the 4000 default.
PORT="4000"

# ==================================================================
# Audio extraction (/audio/*) — for the main app's admin hook editor
# ==================================================================
# This service does a second job besides sockets: it runs yt-dlp + ffmpeg to
# produce the decoded audio the main app's hook editor draws its waveform from.
# That editor places Song.hookStartMs to the millisecond and the YouTube IFrame
# API can't support it (±50-250ms seeks, no access to samples), so real audio has
# to come from somewhere — and a Vercel function has neither binary nor a disk.
#
# Extracted audio is uploaded to the same R2 bucket the main app uses. The main
# app serves it from there; this service never sends audio to a browser.
#
# In production these come from render.yaml. This file is local dev + docs.

# Shared secret the main app presents as `Authorization: Bearer <secret>`.
# Must match AUDIO_SERVICE_SECRET in the main app's environment exactly.
#
# NOT optional: /audio/* refuses every request while this is unset, on purpose.
#   openssl rand -base64 32
AUDIO_SERVICE_SECRET=""

# Path to the yt-dlp binary. `npm run build` downloads it to ./bin/yt-dlp
# (Render's native Node runtime ships ffmpeg but not yt-dlp, and there's no apt
# or root there). On Render this is set by render.yaml to the absolute checkout
# path; locally, ./bin/yt-dlp after a build.
YTDLP_PATH="./bin/yt-dlp"

# Override only if ffmpeg isn't on PATH. Render's native runtime provides it.
# FFMPEG_PATH="ffmpeg"

# ------------------------------------------------------------------
# Object storage — same bucket and keys as the main app, verbatim
# ------------------------------------------------------------------
# The whole arrangement depends on both writing to ONE bucket: whoever manages
# to extract a song (this service, or a developer's laptop) puts it here, and
# every environment can then serve it. Copy these from the main app's .env.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"

# ------------------------------------------------------------------
# YouTube bot-detection hedges — optional, and only needed once it breaks
# ------------------------------------------------------------------
# YouTube challenges datacenter IPs ("Sign in to confirm you're not a bot") far
# more readily than home connections, and Render is a datacenter. Extraction
# from here may work, work intermittently, or be refused, depending on what
# YouTube is doing that week.
#
# THE BEST FIX IS NOT HERE: review songs from a machine on a home connection.
# The main app extracts locally and uploads to the same bucket, so production
# never asks YouTube at all. Everything below is a patch for when this service
# does have to do the pull itself.

# A Netscape cookies.txt from a signed-in THROWAWAY YouTube account — raw or
# base64 (src/audio/cookies.ts accepts either and writes it to a file, because
# yt-dlp wants a path and Render's free plan has no secret files).
#
# These are full session credentials: never use a personal or business account,
# and expect to re-paste as they expire — YouTube invalidates them faster when
# it sees them used from a datacenter.
YTDLP_COOKIES=""

# Set instead of YTDLP_COOKIES if you already have the jar on disk. Wins if both
# are set.
# YTDLP_COOKIES_FILE=""

# Comma-separated player clients to force, e.g. "android,ios". Sometimes
# sidesteps the bot check entirely. Unset by default because which clients work
# changes with whatever YouTube ships.
YTDLP_PLAYER_CLIENTS=""

# Pin the yt-dlp release the build downloads, e.g. "2026.08.19". Normally leave
# unset: yt-dlp's job is tracking a site that actively changes to break it, and
# an old binary is the most common cause of extraction failures. Pin only when a
# specific deploy needs reproducibility.
# YTDLP_VERSION=""
